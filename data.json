  "sentences": [
    {
      "id": "u1-s1",
      "unit": 1,
      "zh": "这所大学新建的图书馆藏书丰富，设施先进，令人印象深刻。",
      "hint": "impressive",
      "answer": "The new library at this university has diverse collections of books and advanced equipment, which is impressive.",
      "pitfalls": [
        "equipment 为不可数名词，不能加 -s（不能写成 equipments）。",
        "用非限制性定语从句 , which is impressive 衔接“令人印象深刻”，避免主句出现双谓语。",
        "介词短语 at this university 放在 library 后作后置定语。"
      ]
    },
    {
      "id": "u1-s2",
      "unit": 1,
      "zh": "我和我的室友对中国传统剪纸很感兴趣，所以我们加入了剪纸俱乐部。",
      "hint": "go along",
      "answer": "My roommate and I are really into traditional Chinese paper-cutting, so we went along to the paper-cutting club.",
      "pitfalls": [
        "必须使用提示词 go along，且后接具体活动/地点时需加介词 to（go along to ...）。",
        "“剪纸”写作 paper-cutting（带连字符，不用 paper cuttings）。",
        "“我和我的室友”作主语用主格 My roommate and I，谓语动词用复数 are。"
      ]
    },
    {
      "id": "u1-s3",
      "unit": 1,
      "zh": "学生食堂汇集了中国各地的美食，我每天都能品尝不同的菜，从来没有过食欲不佳。",
      "hint": "lose one's appetite",
      "answer": "Delicious food from all over China gathers in the student canteen. I can taste a variety of dishes every day and have never lost my appetite.",
      "pitfalls": [
        "lose one's appetite 中 lose 是动词，不能误作名词使用；“从来没有过”用现在完成时 have never lost my appetite。",
        "everyday（形容词“日常的”）与 every day（副词短语“每天”）需区分。",
        "food 为不可数名词，作主语时谓语用单数 gathers；student canteen 前需加定冠词 the。"
      ]
    },
    {
      "id": "u1-s4",
      "unit": 1,
      "zh": "很多高校本科生担任了2022年北京冬奥会志愿者，他们用行动表达了对祖国的热爱。",
      "hint": "college undergraduate",
      "answer": "Many college undergraduates served as volunteers for the 2022 Beijing Winter Olympic Games. They demonstrated their love for their motherland through actions.",
      "pitfalls": [
        "必须使用提示词 college undergraduate（复数 college undergraduates），勿漏掉 college。",
        "专有名词 2022 Beijing Winter Olympic Games 首字母需全部大写。",
        "“用行动”常用 through actions，不用 by actions。"
      ]
    },
    {
      "id": "u1-s5",
      "unit": 1,
      "zh": "中国大学生一般住集体宿舍，大家应该约束自己，不能破坏宿舍的规定。",
      "hint": "break a rule",
      "answer": "Chinese college students usually live in dormitories. Everyone should discipline themselves and not break the dormitory rules.",
      "pitfalls": [
        "“大学生”用 college students，不要漏掉 college。",
        "“约束自己”可用 discipline themselves。",
        "“宿舍规定”用 dormitory rules（不用缩写 dorm）。"
      ]
    },
    {
      "id": "u2-s0",
      "unit": 2,
      "zh": "去国外留学，学生必须自己适应新的语言环境，同时学会独立处理学习和生活中的各种挑战。",
      "hint": "orient oneself",
      "answer": "When studying abroad, students must orient themselves to the new language environment while also learning to independently handle various challenges in their studies and daily lives.",
      "pitfalls": [
        "orient oneself to sth. 表示“使自己适应某事”，反身代词需与主语 students 一致用 themselves",
        "various challenges 前不加不定冠词 a，challenge 用复数形式",
        "while also learning to ... 中 while 后接现在分词，且 studies / daily lives 注意复数"
      ]
    },
    {
      "id": "u2-s1",
      "unit": 2,
      "zh": "越来越多的中国年轻人在国际交流中发挥重要作用，他们用生动的故事向世界展现可信、可爱、可敬的中国形象。",
      "hint": "international communication",
      "answer": "More and more young Chinese people are playing an important role in international communication, using vivid stories to present China as a country of trust, friendship and respect to the world.",
      "pitfalls": [
        "important 以元音音素开头，前面冠词必须用 an（不是 a）",
        "“可敬的”需用形容词 respectable，不能直接用名词 respect",
        "“中国年轻人”译为 young Chinese people（不用非正式的 Chinese fellows），“展现……给世界”用 present ... to the world"
      ]
    },
    {
      "id": "u2-s2",
      "unit": 2,
      "zh": "作为中华文化的重要组成部分，汉字既是表达思想和感情的工具，也是传承文化的媒介。",
      "hint": "an integral part",
      "answer": "As an integral part of Chinese culture, Chinese characters are both a tool to express thoughts and feelings and a medium to pass on culture.",
      "pitfalls": [
        "必须使用提示词 an integral part，不可用 essential 替代",
        "both ... and ... 连接的两个表语应保持单数平行：a tool ... and a medium ...",
        "“传承文化”按老师批改用不定式 to pass on culture，且 Chinese 首字母需大写"
      ]
    },
    {
      "id": "u2-s3",
      "unit": 2,
      "zh": "一百多年前，甲骨文（oracle bone script）的发现为解开汉字起源之谜提供了证据。",
      "hint": "solve a puzzle",
      "answer": "More than a hundred years ago, the discovery of oracle bone script provided evidence to solve the puzzle of the origins of Chinese characters.",
      "pitfalls": [
        "必须使用提示词 solve a/the puzzle，不用原手写稿划掉的 unravel the mystery",
        "后接 of the origins of Chinese characters 特指“汉字起源之谜”，puzzle 前宜用定冠词 the",
        "“一百多年前”为过去时间状语，谓语动词用一般过去时 provided"
      ]
    },
    {
      "id": "u2-s4",
      "unit": 2,
      "zh": "通过汉语中的“吉他”“芭蕾”等外来词，我们可以窥见中国语言和文化的包容性。",
      "hint": "inclusiveness; get a glimpse of",
      "answer": "Through loanwords in Chinese such as \"guitar\" and \"ballet\", we can get a glimpse of the inclusiveness of Chinese language and culture.",
      "pitfalls": [
        "“外来词”按老师批改用 loanwords（不用 foreign words）",
        "句中“吉他”“芭蕾”需译为英文 \"guitar\" and \"ballet\"",
        "inclusiveness 后有 of ... 修饰，前面需加定冠词 the"
      ]
    },
    {
      "id": "u2-s5",
      "unit": 2,
      "zh": "用傅雷的话说，语言是无法速成的。所以学外语时我们要保持耐心，做好长期学习的准备。",
      "hint": "to quote sb.",
      "answer": "To quote Fu Lei, a language cannot be acquired quickly. Therefore, we need to be patient when learning a foreign language and get ready for long-term study.",
      "pitfalls": [
        "必须使用提示词 to quote sb.，且“傅雷”英文姓在前名在后写作 Fu Lei（不是 Lei Fu）",
        "两处谓语 need to be patient 与 get ready 之间需加并列连词 and",
        "“长期学习”中的复合形容词需加连字符写作 long-term study"
      ]
    }
  ]
